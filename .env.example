# Database
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/third_world
DATABASE_SSL=false
DATABASE_POOL_MAX=10

# Development-only admin preview. Never enable this in production.
THIRD_WORLD_ADMIN_PREVIEW=false

# Drop preview / public countdown
NEXT_PUBLIC_DROP_OPENS_AT=2026-10-30T20:00:00-04:00

# Phase 04 — checkout lifecycle
# off = disabled, test = provider test-mode allowed, live = requires finalized tax/duties readiness
CHECKOUT_MODE=off

# Payments
PAYMENT_PROVIDER=stripe
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PAYMENT_METHOD_CONFIGURATION=

# Stripe Tax for custom checkout
STRIPE_TAX_ENABLED=false
# Configure the correct Stripe Tax apparel category before live launch.
STRIPE_TAX_CODE_APPAREL=

# Shipping / carrier rates
EASYPOST_API_KEY=
SHIP_FROM_NAME=3RD WORLD
SHIP_FROM_LINE1=
SHIP_FROM_LINE2=
SHIP_FROM_CITY=
SHIP_FROM_STATE=
SHIP_FROM_POSTAL_CODE=
SHIP_FROM_COUNTRY=US
SHIP_FROM_PHONE=
SHIP_FROM_EMAIL=
DEFAULT_PARCEL_LENGTH_IN=14
DEFAULT_PARCEL_WIDTH_IN=10
DEFAULT_PARCEL_HEIGHT_IN=4
DEFAULT_ITEM_WEIGHT_GRAMS=650

# Optional EasyPost + Zonos landed-cost workflow for eligible international carrier accounts.
USE_EASYPOST_LANDED_COST=false

# FX / local currency
OPEN_EXCHANGE_RATES_APP_ID=
FX_MARGIN_BPS=0

# Safe fallback while live carrier/FX integrations are not configured.
GLOBAL_STANDARD_SHIPPING_USD=2500
GLOBAL_FREE_SHIPPING_USD=20000

# Catalog bootstrap defaults. Leave 0 unless intentionally seeding test inventory.
SEED_INVENTORY_PER_SIZE=0

# Phase 05 — WORLD / Drop access engine
# Use a long random secret in production. Required for private/code access.
DROP_ACCESS_SECRET=
